# Server Environment Configuration
PORT=5000
NODE_ENV=development
JWT_SECRET=super-secret-jwt-key-human-digital-twin-2026-production-ready
CORS_ORIGIN=http://localhost:5173

# Database URL
# Default local SQLite file:
DATABASE_URL="file:./dev.db"
# If using PostgreSQL in production or container:
# DATABASE_URL="postgresql://postgres:postgres@localhost:5432/humandigitaltwin?schema=public"

# AI Integration
# If OPENAI_API_KEY is not provided, the system seamlessly runs in local deterministic AI intelligence mode.
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o-mini"

# Client Vite Configuration (client/.env)
VITE_API_URL=http://localhost:5000/api
